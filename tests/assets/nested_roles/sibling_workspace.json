{
  "templates": {
    "stores_template": {
      "role": "stores",
      "layers": {
        "OSM_STORES": {
          "display": true,
          "format": "tiles",
          "URI": "https://{a-c}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        }
      },
      "locales": ["brand_a_template", "brand_b_template"]
    },
    "nested_template": {
      "role": "nested",
      "layers": {
        "OSM_Nested": {
          "display": true,
          "format": "tiles",
          "URI": "https://{a-c}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        }
      },
      "locales": ["brand_a_template", "brand_b_template"]
    },
    "demographics_template": {
      "role": "demographics",
      "layers": {
        "OSM_DEMOGRAPHICS": {
          "display": true,
          "format": "tiles",
          "URI": "https://{a-c}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        }
      }
    },
    "brand_a_template": {
      "src": "file:./tests/assets/nested_roles/brand_a_template.json"
    },
    "brand_b_template": {
      "src": "file:./tests/assets/nested_roles/brand_b_template.json"
    }
  },
  "locale": {
    "layers": {
      "OSM": {
        "display": true,
        "format": "tiles",
