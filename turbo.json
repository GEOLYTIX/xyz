{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["MAPBOX_ACCESS_TOKEN", "MAPBOX_STYLE_URL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "workspace:cache": {
      "cache": false,
      "outputs": []
    }
  }
}
