# @defaultRequired=infer
# @defaultSensitive=false
# @currentEnv=$APP_ENV
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/google-secret-manager-plugin)
# @initGsm(projectId=$GCP_PROJECT_ID, credentials=$GOOGLE_CREDENTIALS)
# @generateTypes(lang=ts, path=env.d.ts)
# ---

# Environment selection and Google Secret Manager resolution.
# Platform variables such as NODE_ENV, VERCEL, or XYZ_CWD are intentionally
# not declared; declared keys are injected from the frozen blob and would
# override the values provided by the platform at runtime.
# @sensitive=false
APP_ENV=development
# @sensitive=false
GCP_PROJECT_ID=
# @type=gcpServiceAccountJson @sensitive
GOOGLE_CREDENTIALS=

# Optional app configuration. Sensitive by default unless explicitly marked.
# Values belong in ignored .env files or Vercel variables, not in the schema.
# @sensitive=false
DIR=
# @sensitive=false @type=url
WORKSPACE=file:./public/workspace.json
# @sensitive=true @type=string
PUBLIC=gsm('PUBLIC')
