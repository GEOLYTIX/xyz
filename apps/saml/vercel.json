{
  "version": 2,
  "trailingSlash": false,
  "builds": [
    {
      "src": "apps/saml/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          ".varlock.blob",
          "public/**",
          "apps/saml/*.crt",
          "apps/saml/*.pem",
          "apps/xyz/*.pem"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/saml/server.js"
    }
  ]
}
