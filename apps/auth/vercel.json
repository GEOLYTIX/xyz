{
  "version": 2,
  "trailingSlash": false,
  "builds": [
    {
      "src": "apps/auth/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [".varlock.blob", "public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/auth/server.js"
    }
  ]
}
