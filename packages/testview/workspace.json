            "default": {
              "strokeColor": "#333",
              "strokeWidth": 2,
              "fillColor": "#9996",
              "icon": { "type": "dot", "fillColor": "#999", "scale": 1.5 }
            },
            "theme": {
              "title": "Distributed",
              "type": "distributed",
              "field": "id",
              "categories": [
                {
                  "style": {
                    "strokeColor": "#911eb4",
                    "strokeWidth": 4,
                    "fillColor": "#911eb466",
                    "icon": {
                      "type": "dot",
                      "fillColor": "#911eb4",
                      "scale": 1.5
                    }
                  }
                },
                {
                  "style": {
                    "strokeColor": "#42d4f4",
