# @defaultRequired=false
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @encryptInjectedEnv=forEnv(production)
# @plugin(./utils/varlock-gsm-plugin.cjs)
# @initGsm(projectId=$GCP_PROJECT_ID, credentials=$GOOGLE_CREDENTIALS)
# ---

# Build/runtime selectors.
# @sensitive=false
APP_ENV=development
# @sensitive=false
GCP_PROJECT_ID=
# @sensitive=false
GCP_SERVICE_ACCOUNT_EMAIL=
# @sensitive=false
GCP_WORKLOAD_IDENTITY_PROVIDER=
# @sensitive=false
GOOGLE_CLOUD_PROJECT=
# @sensitive=false
NODE_ENV=production
# @sensitive=false
VERCEL=
# Vercel OIDC token. Provided automatically only when OIDC is enabled for the Vercel project/deployment.
VERCEL_OIDC_TOKEN=
# @sensitive=false
XYZ_CWD=

# Server defaults mirrored from apps/xyz/mod/utils/processEnv.js.
# @sensitive=false
COOKIE_TTL=36000
# @sensitive=false
DIR=
# @sensitive=false
FAILED_ATTEMPTS=3
# @sensitive=false
FILE_RESOURCES=resources
# @sensitive=false
PORT=3000
# @sensitive=false
RATE_LIMIT=1000
# @sensitive=false
RATE_LIMIT_WINDOW=60000
# @sensitive=false
RETRY_LIMIT=3
# @sensitive=false
SECRET_ALGORITHM=HS256
# @sensitive=false
TITLE=GEOLYTIX | XYZ
# @sensitive=false
TRANSPORT_PORT=587
# @sensitive=false
TRANSPORT_TLS=false
# @sensitive=false
WORKSPACE_AGE=3600000

# Optional app configuration. Sensitive by default unless explicitly marked above.
_VARLOCK_ENV_KEY=
AWS_S3_CLIENT=
AUTH_EXPIRY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS=
CLOUDINARY_URL=
CUSTOM_TEMPLATES=
KEY_CLOUDFRONT=
LOGGER=
LOGS=
PASSWORD_REGEXP=
PRIVATE=
PUBLIC=
SAML_ACCEPTED_CLOCK_SKEW=
SAML_ACS=
SAML_AUTHN_RESPONSE_SIGNED=
SAML_ENTITY_ID=
SAML_IDENTIFIER_FORMAT=
SAML_IDP_CRT=
SAML_PROVIDER_NAME=
SAML_SIGNATURE_ALGORITHM=
SAML_SLO=
SAML_SP_CRT=
SAML_SSO=
SAML_WANT_ASSERTIONS_SIGNED=
SECRET=
SECRET_KEY=
SLO_CALLBACK=
STATEMENT_TIMEOUT=
TRANSPORT_EMAIL=
TRANSPORT_PASSWORD=
USER_DOMAINS=
USER_SESSION=
VERCEL_TOKEN=
WORKSPACE=
