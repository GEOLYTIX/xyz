# @defaultRequired=false
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/google-secret-manager-plugin)
# @initGsm(projectId=$GCP_PROJECT_ID, credentials=$GOOGLE_CREDENTIALS)
# ---

# Environment selection and Google Secret Manager resolution.
# Platform variables such as NODE_ENV, VERCEL, or XYZ_CWD are intentionally
# not declared; declared keys are injected from the frozen blob and would
# override the values provided by the platform at runtime.
# @sensitive=false
APP_ENV=development
# @sensitive=false
GCP_PROJECT_ID=
