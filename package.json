{
  "name": "xyz",
  "version": "v5.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/geolytix/xyz"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "turbo run dev --filter=@geolytix/xyz-app",
    "freeze-env": "node utils/freeze-env.js",
    "dev:auth": "turbo run dev --filter=@geolytix/xyz-auth-app",
    "dev:saml": "turbo run dev --filter=@geolytix/xyz-saml-app",
    "testview": "pnpm --filter=@geolytix/xyz-testhost start",
    "deploy:vercel": "node utils/deploy-vercel.js",
    "bump:patch": "node utils/bump-version.js patch",
    "bump:minor": "node utils/bump-version.js minor",
    "bump:major": "node utils/bump-version.js major",
    "test": "turbo run test",
    "test:saml": "turbo run test --filter=@geolytix/xyz-saml-app",
    "test:xyz": "turbo run test --filter=@geolytix/xyz-app",
    "test:coverage": "turbo run test:coverage --filter=@geolytix/xyz-app --filter=@geolytix/xyz-saml-app",
    "test:xyz:coverage": "turbo run test:coverage --filter=@geolytix/xyz-app",
    "test:mapp": "pnpm --filter=@geolytix/mapp test",
    "test:mapp:coverage": "pnpm --filter=@geolytix/mapp test:coverage",
    "test:ui": "pnpm --filter=@geolytix/mapp-ui test",
    "test:ui:coverage": "pnpm --filter=@geolytix/mapp-ui test:coverage",
    "build": "turbo run build",
    "knowledge:changed": "node utils/knowledge/changed.mjs",
    "knowledge:check": "node utils/knowledge/validate.mjs",
    "knowledge:find": "node utils/knowledge/find.mjs",
    "knowledge:schema": "node utils/knowledge/schema.mjs",
    "knowledge:examples": "vitest run --config utils/knowledge/examples/vitest.config.mjs",
    "knowledge:test": "vitest run --dir utils/knowledge --exclude \"**/examples/**\"",
    "knowledge:wiki": "node utils/knowledge/wiki.mjs",
    "knowledge:site:dev": "vitepress dev utils/knowledge/site",
    "knowledge:site:build": "vitepress build utils/knowledge/site",
    "knowledge:site:preview": "vitepress preview utils/knowledge/site",
    "login-public-key": "varlock run -- node ./utils/printLoginPublicKey.js",
    "push-env": "node ./utils/sync-vercel-env.js",
    "workspace:cache": "turbo run workspace:cache --filter=@geolytix/xyz-app"
  },
  "license": "MIT",
  "dependencies": {
    "@geolytix/mapp": "workspace:*",
    "@geolytix/mapp-ui": "workspace:*",
    "@geolytix/xyz-auth-app": "workspace:*",
    "@geolytix/xyz-app": "workspace:*",
    "@geolytix/xyz-saml-app": "workspace:*",
    "@varlock/google-secret-manager-plugin": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "markdown-it": "catalog:",
    "markdown-it-footnote": "catalog:",
    "node-mocks-http": "catalog:",
    "turbo": "catalog:",
    "undici": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
