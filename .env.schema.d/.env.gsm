# Google Secret Manager configuration.
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/google-secret-manager-plugin)
# @initGsm(
#   projectId=$GCP_PROJECT_ID,
#   workloadIdentityProvider=$GCP_WORKLOAD_IDENTITY_PROVIDER,
#   serviceAccountEmail=$GCP_SERVICE_ACCOUNT_EMAIL
# )

# Google Cloud project used by gsm() secret references.
# @type=string
GCP_PROJECT_ID=

# Full Workload Identity Provider resource name for Vercel OIDC deployments.
# Leave empty for local ADC.
# @type=string
GCP_WORKLOAD_IDENTITY_PROVIDER=

# Service account impersonated by Vercel OIDC deployments.
# Leave empty for local ADC.
# @type=string
GCP_SERVICE_ACCOUNT_EMAIL=
