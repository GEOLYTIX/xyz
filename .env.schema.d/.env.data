# Database and Google Secret Manager configuration.
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/google-secret-manager-plugin)
# @initGsm(projectId=$GCP_PROJECT_ID)

# @sensitive @type=string
DBS=

# Add application-specific DBS_* keys in a deployment schema.
# Example:
# # @sensitive @type=string
# DBS_CLIENT=

# Google Cloud project used by gsm() secret references.
# @type=string
GCP_PROJECT_ID=

# Optional Google service account JSON. Use JSON content, not a file path.
# @sensitive @type=gcpServiceAccountJson
GCP_SA_KEY=
