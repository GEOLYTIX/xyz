# Optional SAML authentication configuration.
# @defaultRequired=false @defaultSensitive=false

# Assertion Consumer Service URL where SAML responses are received.
# @type=url
SAML_ACS=

# Single Sign-On URL of the Identity Provider.
# @type=url
SAML_SSO=

# Single Logout URL for terminating sessions.
# @type=url
SAML_SLO=

# Service Provider Entity ID.
# @type=string
SAML_ENTITY_ID=

# Base name for the IdP certificate file, without the .crt extension.
# @type=string
SAML_IDP_CRT=

# Base name for the SP certificate pair files, without the .pem/.crt extension.
# @type=string
SAML_SP_CRT=

# @type=boolean
SAML_WANT_ASSERTIONS_SIGNED=

# @type=boolean
SAML_AUTHN_RESPONSE_SIGNED=false

# @type=enum(sha1, sha256, sha512)
SAML_SIGNATURE_ALGORITHM=sha256

# @type=string
SAML_IDENTIFIER_FORMAT=

# @type=number
SAML_ACCEPTED_CLOCK_SKEW=-1

# @type=string
SAML_PROVIDER_NAME=

# @type=boolean
SAML_DISABLE_REQUESTED_AUTHN_CONTEXT=true

# URL for handling logout callbacks.
# @type=url
SLO_CALLBACK=
