{
  "dbs": "DEVDB",
  "locales": {
    "countries": {
      "name": "Countries",
      "view": { "lat": 50, "lng": 10, "z": 3 },
      "layers": {
        "countries": {
          "name": "Countries",
          "display": true,
          "format": "geojson",
          "table": "naturalearth.countries",
          "geom": "geom_4326",
          "srid": "4326",
          "qID": "id",
          "roles": {
            "*": true,
            "europe": {
              "filter": {
                "default": {
                  "continent": { "match": "Europe" }
                }
              }
            }
          },
          "infoj": [
            { "type": "key" },
            { "title": "Name", "field": "name" },
            { "title": "ISO A3", "field": "iso_a3" },
            {
              "title": "Continent",
              "field": "continent",
              "filter": { "type": "in" }
            },
            { "title": "Subregion", "field": "subregion" },
            { "title": "Population", "field": "pop_est", "type": "integer" }
          ],
          "style": {
            "default": {
              "strokeColor": "#333",
              "fillColor": "#9996"
            },
            "hover": { "field": "name" },
            "theme": {
              "title": "Continent",
              "type": "categorized",
              "field": "continent",
              "cat": {
                "Europe": { "fillColor": "#4363d8" },
                "Africa": { "fillColor": "#f58231" },
                "Asia": { "fillColor": "#3cb44b" },
                "North America": { "fillColor": "#e6194b" },
                "South America": { "fillColor": "#ffe119" },
                "Oceania": { "fillColor": "#911eb4" }
              }
            }
          }
        }
      }
    }
  }
}
