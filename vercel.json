{
  "version": 2,
  "trailingSlash": false,
  "builds": [
    {
      "src": "apps/xyz/vercel.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          ".env.schema",
          ".varlock.blob",
          ".env.production",
          "utils/vercel-oidc.js",
          "public/**",
          "resources/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/xyz/vercel.js"
    }
  ]
}
